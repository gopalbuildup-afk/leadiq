# API base baked into the production build (set before `npm run build`).
# Default is same-origin "/api" (serve the UI behind a proxy).
VITE_LEADIQ_API_URL=/api

# Backend address for `npm run dev` only (Vite proxy target).
# Must match the port you launch uvicorn with. Restart `npm run dev`
# after changing vite.config.ts / this value.
# LEADIQ_API_URL=http://127.0.0.1:8000
